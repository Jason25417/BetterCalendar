<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>执行你的专注快捷指令；读取前台浏览器当前页的网址和标题，记进「设备活动记录（实验）」给 BetterCalendar 智能体当情境（设置里可暂停或关闭）。</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>把你的计划写入一个专用「计划」日历(Dev)并读回做对比</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>按麦克风说话时，把你说的话转成文字发给智能体（只在你按下时录音）。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>把你说的话转成文字（优先在本机识别）。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>用 Face ID 解锁你的日记（隐私锁）</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>仅在你明确设置一次闹钟时，允许 BetterCalendar 使用系统原生闹钟。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>只读你的睡眠和锻炼记录，当作被动线索：帮 BetterCalendar 对照「计划 vs 实际」，并在你允许时给它的智能体当背景。不写入任何健康数据。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>BetterCalendar 只读取睡眠和锻炼记录，不会写入或修改你的健康数据。</string>
	<key>NSHomeKitUsageDescription</key>
	<string>读取你的家居存在传感器状态，帮助区分书桌与床边的活动线索。</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>应用未打开时接收明显地点变化与到访记录，避免要求你手动记录。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>了解你大致所在的地点，为个人生活建议提供背景。</string>
	<key>NSMotionUsageDescription</key>
	<string>读取步行、骑行或乘车状态，为个人记录提供线索。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>把要紧事写进提醒事项并带提前提醒</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).handoff</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
