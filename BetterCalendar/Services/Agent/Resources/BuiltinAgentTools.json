[
 {
  "type": "function",
  "function": {
   "name": "read_context",
   "description": "读取 BetterCalendar 此刻的状态快照（今天与未来 7 天的安排、计时、待办与长期事项、Jason 自己的日历与提醒事项（只读）、最近实际、最近设备活动摘要、可执行目标的 id 与版本）。快照里读取失败的块带 error，不能当成「没有」。",
   "parameters": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "propose_change",
   "description": "向 Jason 提交一项改动提案（iPhone 与 Mac 同时推审批通知）。提交≠执行：要他批准、设备回报「已完成」才算完成。种类与规则见系统提示「提出改动」。被拒收时返回原因（rejected），看原因调整后再提，或如实告诉他放不下、为什么。 低风险改动（单块加 / 挪 / 改时长或名字、建提醒）可能被 App 规则自动通过并立即执行（结果 preauth.ruleId = 低风险规则），对话里留回执可撤销。 一件事一份提案：同一次行动里同一类的待批提案 App 会自动合成一张批量卡，Jason 可以逐项批准或拒绝，每份各自有结果。",
   "parameters": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "description": "通知标题：一句话说明是什么事（≤80 字）"
     },
     "reason": {
      "type": "string",
      "description": "一句人话理由（讲得出依据，含 Jason 原话与你的关键假设）"
     },
     "action": {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string",
        "description": "改动种类",
        "enum": [
         "itemCreate",
         "itemEdit",
         "itemSetDone",
         "timer",
         "moveBlock",
         "moveBlocks",
         "blockCreate",
         "blockEdit",
         "blockDelete",
         "planDay",
         "reminder",
         "alarm",
         "yourEventEdit",
         "yourEventDelete",
         "yourReminderEdit",
         "yourReminderDelete",
         "itemDelete",
         "checkpointDelete",
         "checkpointCreate",
         "journalAppend",
         "journalEdit",
         "experimentNoop"
        ]
       },
       "itemId": {
        "type": "string",
        "description": "itemEdit / itemSetDone / itemDelete / checkpointDelete / checkpointCreate：事项 id（actionTargets.items[].id；checkpointCreate 要 zone=longterm 的长期事项）"
       },
       "title": {
        "type": "string",
        "description": "itemCreate / itemEdit：事项标题；timer start：计划外的事的名字；reminder / alarm：标题（≤150）；blockEdit：新标题；yourEventEdit / yourReminderEdit：新标题；checkpointCreate：新阶段标题（≤200）"
       },
       "body": {
        "type": "string",
        "description": "reminder：提醒备注（可选）"
       },
       "fireAt": {
        "type": "string",
        "description": "reminder / alarm：时刻，ISO 8601 带时区"
       },
       "device": {
        "type": "string",
        "description": "alarm（必填）：iPhone 的设备 id（actionTargets.devices[] 里 platform=iOS）"
       },
       "note": {
        "type": "string",
        "description": "itemCreate / itemEdit：备注；experimentNoop：说明"
       },
       "done": {
        "type": "boolean",
        "description": "itemSetDone / yourReminderEdit：true=标完成，false=取消完成"
       },
       "command": {
        "type": "string",
        "description": "timer：计时指令",
        "enum": [
         "start",
         "pause",
         "resume",
         "stop"
        ]
       },
       "blockId": {
        "type": "string",
        "description": "timer start：今天计划块 id；moveBlock / blockEdit / blockDelete：计划块 id"
       },
       "start": {
        "type": "string",
        "description": "moveBlock：新开始；yourEventEdit：他日程的新开始（ISO 8601 带时区）"
       },
       "end": {
        "type": "string",
        "description": "moveBlock / yourEventEdit：新结束（可选，省略 = 保持原时长）"
       },
       "day": {
        "type": "string",
        "description": "blockCreate / planDay / journalAppend：逻辑日 yyyy-MM-dd（凌晨 0–4 点属于前一天）"
       },
