           "type": "integer",
           "description": "新时长（分钟，开始不动）"
          },
          "fixed": {
           "type": "boolean",
           "description": "取消固定要越级"
          },
          "important": {
           "type": "boolean"
          },
          "deadline": {
           "type": "string",
