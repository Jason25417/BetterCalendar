 {
  "type": "function",
  "function": {
   "name": "read_proposals",
   "description": "查看你（BetterCalendar 智能体）最近提交的提案的最新状态：待确认 / 已同意 / 已完成 / 已拒绝 / 已过期 / 失败 / 已撤销 / replied（他回了一句，userReply.text 是原话）、选了哪个方案、可调参数他改没改、是否由预授权规则代他决定。",
   "parameters": {
    "type": "object",
    "properties": {
     "limit": {
      "type": "integer",
      "description": "最多几份（1–50，默认 20）"
     }
    },
    "required": [],
    "additionalProperties": false
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "reply_jason",
   "description": "在 BetterCalendar 的对话里回复 Jason（他在 iPhone / Mac 的「智能体」页看到，可能弹通知）。他在对话里跟你说话（user_message）时必须用它回答；晚间复盘也用它写（kind=eveningReview）。要带提案卡片：先 propose_change 拿到 id 再放进 proposalIds。",
   "parameters": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "description": "回复正文（≤1000 字）：简短、口语、指向下一步；不翻旧账、不算账"
     },
     "replyTo": {
      "type": "string",
      "description": "回应的是哪条 Jason 的消息（事件 payload.messageId）；主动开口 / 晚间复盘省略"
     },
     "proposalIds": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "要以卡片呈现的提案 id（≤5）"
     },
     "kind": {
      "type": "string",
      "description": "默认 chat；晚间复盘填 eveningReview",
      "enum": [
       "chat",
       "eveningReview"
      ]
     }
    },
    "required": [
     "text"
    ],
    "additionalProperties": false
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "notify_jason",
   "description": "主动给 Jason 发一句话（系统通知，只有「好 / 静音」）。只在关键时刻、确有一个他认可方向上的现在就能做的下一步时用；App 按打扰规则决定弹出还是拦下。同一件事不要和 reply_jason 都发。",
   "parameters": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "description": "通知标题（≤60 字）"
     },
     "body": {
      "type": "string",
      "description": "一两句话正文（≤300 字），指向下一步"
     },
     "reason": {
      "type": "string",
      "description": "为什么此刻值得说（留底用，不展示）"
     }
    },
    "required": [
     "title",
     "body",
     "reason"
    ],
    "additionalProperties": false
   }
  }
 },
 {
